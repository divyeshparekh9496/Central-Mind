# Google Gemini API Key (FREE tier available!)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Anthropic Claude API Key (paid)
ANTHROPIC_API_KEY=

# Optional: For enhanced web search
SEARCH_API_KEY=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Semantic Cache Settings
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_TTL_HOURS=24
CACHE_MAX_ENTRIES=1000

# Safeguard Settings
REQUEST_TIMEOUT_SECONDS=120
MAX_CONCURRENT_LLM_CALLS=5
CIRCUIT_BREAKER_THRESHOLD=5
MAX_QUERY_LENGTH=500

# Research RAG. Online research and root /chat refresh on every request.
RAG_DB_PATH=data/rag.sqlite3
# BM25 is the measured stronger default; opt into the trained linear model:
# RAG_MODEL_PATH=models/evidence_ranker.json
RAG_MAX_AGE_HOURS=24
RAG_TOP_K=6
# Optional neural reranker; install requirements-transformers.txt first.
# RAG_CROSS_ENCODER=cross-encoder/ms-marco-MiniLM-L6-v2
